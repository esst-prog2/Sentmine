{
  "manifest_version": 3,
  "name": "Open in sentmine",
  "version": "0.2.0",
  "description": "Open the PDF or web page in this tab in sentmine, or make cards from text you select, in a panel beside the page. Works with sentmine running on your own computer.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open in sentmine",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*"]
}
